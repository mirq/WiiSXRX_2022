# WiiStation (WiiSXRX_2022) for WarpOS (PowerPC Amiga), MiniGL R200 renderer.
#
#   make -f WarpOS/Makefile.warpos -j$(nproc)    -> build/warpos/WiiStation
#
# Built by ppc-amigaos-gcc (adtools 8.4) with the MOS2WOS WarpOS overlay,
# through the MiniGL SDK's common file, which holds the toolchain paths and the
# ET_REL contract: the link is a relocatable ELF, which tools/elf2warpos turns
# into the WarpOS executable here, on Linux.
#
# Run from the repository root.

MGL_DIR ?= /home/mirek/MiniGL_WOS_V19_mglQ3
# The oldest WarpOS boards (Blizzard/CyberStorm PPC) are 603e/604e: code for a
# 603e runs on every one of them.
CPU     ?= 603e
include $(MGL_DIR)/Makefile.wos.gcc.common

SHELL  := /bin/bash
OUT    := build/warpos
OBJDIR := $(OUT)/obj
ELF    := $(OUT)/WiiStation.warpelf
DEBUG_ELF := $(OUT)/WiiStation.debug.elf
TARGET := $(OUT)/WiiStation
PYTHON ?= python3

BUILD_STAMP := $(shell git describe --always --dirty 2>/dev/null || echo unknown)

# ---- Sources -----------------------------------------------------------

PLATFORM_SRCS := $(wildcard WarpOS/*.c)

SRCS := $(PLATFORM_SRCS)

# ---- Flags -------------------------------------------------------------

# The MOS2WOS overlay ships SDL 1.2 and puts its headers on the include path:
# take them off, so a forgotten <SDL.h> fails instead of compiling against it.
WOS_CPPFLAGS_NOSDL := $(subst -isystem $(WOS_SDK_ROOT)/include/sdl,,$(WOS_CPPFLAGS))

# -fsigned-char: char is UNSIGNED on PPC; the emulator assumes signed.
# -fno-common: the ET_REL check refuses COMMON symbols (GCC 8 defaults to them).
# -msdata=none -G0: no small-data relocations, which the converter cannot translate.
# -Uamiga -Uamigaos: the compiler predefines these outside the reserved namespace.
DEFINES := -D__WARPOS__ -DPSX_HOST_BIG_ENDIAN_PPC -D__BIG_ENDIAN__ \
           -DCPU_IS_BIG_ENDIAN=1 -DWORDS_BIGENDIAN=1 -D__ppc__ -D__powerpc__ \
           -DUSE_LIBCHDR -DHAVE_LROUND -DPACKAGE_VERSION=\"1.3.2\" \
           -DWOS_BUILD_STAMP=\"$(BUILD_STAMP)\"

CFLAGS_COMMON := $(WOS_ARCH_CFLAGS) -O2 -g -fno-strict-aliasing -fsigned-char \
          -fno-common -msdata=none -G0 -MMD -MP \
          $(DEFINES) $(WOS_CPPFLAGS_NOSDL) -Uamiga -Uamigaos \
          -IWarpOS -I. $(EXTRA_CFLAGS)

CFLAGS := -std=gnu99 $(CFLAGS_COMMON) -w

# A changed flag rebuilds every object.
BUILD_FLAGS_STAMP := $(OBJDIR)/.build-flags
$(shell mkdir -p $(OBJDIR); f='$(CFLAGS)'; [ "$$(cat $(BUILD_FLAGS_STAMP) 2>/dev/null)" = "$$f" ] || printf '%s' "$$f" > $(BUILD_FLAGS_STAMP))

OBJS := $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

.PHONY: all clean
all: $(TARGET)

$(OBJDIR)/%.o: %.c $(BUILD_FLAGS_STAMP)
	@mkdir -p $(dir $@)
	@echo "  CC  $<"
	@$(CC) $(CFLAGS) -c $< -o $@

# startupwos.o FIRST: the WarpOS loader jumps to the first text hunk, and a
# reordered link dies before main(). The full link, debug info and all, is kept
# for addr2line; the converter gets it with only the debug sections dropped.
$(DEBUG_ELF): $(OBJS)
	@echo "  LD  $@"
	@$(LD) $(WOS_LINK_FLAGS) $(WOS_LIBRARY_DIRS) -o $@ \
		$(WOS_STARTFILE) $(OBJS) $(WOS_RUNTIME_LIBS) $(WOS_ENDFILE)

$(ELF): $(DEBUG_ELF)
	@$(WOS_CROSS)objcopy --strip-debug $< $@
	$(call WOS_VALIDATE_ETREL,$@)

$(TARGET): $(ELF) tools/elf2warpos/elf2warpos.py
	@$(PYTHON) tools/elf2warpos/elf2warpos.py $< $@

clean:
	rm -rf $(OUT)

-include $(DEPS)
