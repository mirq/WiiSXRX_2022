# WiiStation (WiiSXRX_2022) for WarpOS (PowerPC Amiga), MiniGL R200 renderer.
#
#   make -f WarpOS/Makefile.warpos -j$(nproc)    -> build/warpos/WiiStation
#
# Built by ppc-amigaos-gcc (adtools 8.4) with the MOS2WOS WarpOS overlay,
# through the MiniGL SDK's common file, which holds the toolchain paths and the
# ET_REL contract: the link is a relocatable ELF, which tools/elf2warpos turns
# into the WarpOS executable here, on Linux.
#
# Run from the repository root.

MGL_DIR ?= /home/mirek/MiniGL_WOS_V19_mglQ3
# The oldest WarpOS boards (Blizzard/CyberStorm PPC) are 603e/604e: code for a
# 603e runs on every one of them.
CPU     ?= 603e
include $(MGL_DIR)/Makefile.wos.gcc.common

SHELL  := /bin/bash
OUT    := build/warpos
OBJDIR := $(OUT)/obj
ELF    := $(OUT)/WiiStation.warpelf
DEBUG_ELF := $(OUT)/WiiStation.debug.elf
TARGET := $(OUT)/WiiStation
PYTHON ?= python3

BUILD_STAMP := $(shell git describe --always --dirty 2>/dev/null || echo unknown)

# ---- Sources -----------------------------------------------------------

PLATFORM_SRCS := $(wildcard WarpOS/*.c)

# The emulator core: every C file at the top level but the Wii-only ones.
# Fail loudly when a listed name stops existing, so a rename cannot slip a
# Wii file back into the build.
CORE_EXCLUDE := lightrec.c mem2_manager.c
$(foreach f,$(CORE_EXCLUDE),$(if $(wildcard $(f)),,$(error CORE_EXCLUDE lists $(f), which does not exist -- update WarpOS/Makefile.warpos)))
CORE_SRCS := $(filter-out $(CORE_EXCLUDE),$(wildcard *.c))

# From Gamecube/: only the plugin glue and the fileBrowser pointers; the
# menu, input, DVD/SMB/libfat and video files are the Wii's (WarpOS/ has ours).
GC_SRCS := Gamecube/plugins.c Gamecube/Plugin.c Gamecube/fileBrowser/fileBrowser.c

# The software GPUs; SoftGPU/drawGX.c is replaced by WarpOS/wos_draw.c, and
# soft.c/prim.c are #included by gpulib_if.c.
GPU_SRCS := gpulib/oldGpu.c gpulib/gpulib.c gpulib/vout_pl.c \
            SoftGPU/gpulib_if.c SoftGPU/oldGpuFps.c

# dfsound without its SDL and AESND outputs (dfsound/ahi.c is ours).
SPU_EXCLUDE := dfsound/sdl.c dfsound/cube.c
$(foreach f,$(SPU_EXCLUDE),$(if $(wildcard $(f)),,$(error SPU_EXCLUDE lists $(f), which does not exist -- update WarpOS/Makefile.warpos)))
SPU_SRCS := $(filter-out $(SPU_EXCLUDE),$(wildcard dfsound/*.c))

# libchdr and the decompressors it needs (CHD images).
CHDR      := deps/libchdr
CHDR_SRCS := $(wildcard $(CHDR)/src/*.c) \
             $(addprefix $(CHDR)/deps/lzma-19.00/,Alloc.c Bra86.c BraIA64.c CpuArch.c Delta.c \
                 LzFind.c Lzma86Dec.c LzmaDec.c LzmaEnc.c Sort.c) \
             $(addprefix $(CHDR)/deps/zlib-1.3.1/,adler32.c crc32.c inffast.c inflate.c \
                 inftrees.c zutil.c gzlib.c gzread.c gzclose.c gzwrite.c deflate.c trees.c \
                 compress.c uncompr.c) \
             $(wildcard $(CHDR)/deps/zstd-1.5.6/lib/common/*.c) \
             $(wildcard $(CHDR)/deps/zstd-1.5.6/lib/decompress/*.c)

# The ppc/ dynarec (the "old" one: lookup tables, no MMU tricks; Lightrec,
# which needs the Wii's page tables, is not built).
REC_SRCS := ppc/pR3000A.c ppc/ppc.c ppc/reguse.c
REC_ASM  := ppc/pasm.s

SRCS := $(PLATFORM_SRCS) $(CORE_SRCS) $(GC_SRCS) $(GPU_SRCS) $(SPU_SRCS) $(CHDR_SRCS) $(REC_SRCS)

# ---- Flags -------------------------------------------------------------

# The MOS2WOS overlay ships SDL 1.2 and puts its headers on the include path:
# take them off, so a forgotten <SDL.h> fails instead of compiling against it.
WOS_CPPFLAGS_NOSDL := $(subst -isystem $(WOS_SDK_ROOT)/include/sdl,,$(WOS_CPPFLAGS))

# -fsigned-char: char is UNSIGNED on PPC; the emulator assumes signed.
# -fno-common: the ET_REL check refuses COMMON symbols (GCC 8 defaults to them).
# -msdata=none -G0: no small-data relocations, which the converter cannot translate.
# -Uamiga -Uamigaos: the compiler predefines these outside the reserved namespace.
DEFINES := -D__WARPOS__ -DPSX_HOST_BIG_ENDIAN_PPC -D__BIG_ENDIAN__ \
           -DCPU_IS_BIG_ENDIAN=1 -DWORDS_BIGENDIAN=1 -D__ppc__ -D__powerpc__ \
           -DUSE_LIBCHDR -DHAVE_LROUND -DPACKAGE_VERSION=\"1.3.2\" \
           -DWOS_BUILD_STAMP=\"$(BUILD_STAMP)\" -DWOS_HAVE_DYNAREC

CFLAGS_COMMON := $(WOS_ARCH_CFLAGS) -O2 -g -fno-strict-aliasing -fsigned-char \
          -fno-common -msdata=none -G0 -MMD -MP \
          $(DEFINES) $(WOS_CPPFLAGS_NOSDL) -Uamiga -Uamigaos \
          -IWarpOS -I. -IWarpOS/compat -I$(MGL_DIR)/include \
          -I$(CHDR)/include -I$(CHDR)/deps/zlib-1.3.1 -I$(CHDR)/deps/lzma-19.00 \
          -I$(CHDR)/deps/zstd-1.5.6/lib -DZ7_ST -D_7ZIP_ST -DZSTD_DISABLE_ASM \
          $(EXTRA_CFLAGS)

CFLAGS := -std=gnu99 $(CFLAGS_COMMON) -w

# A changed flag rebuilds every object.
BUILD_FLAGS_STAMP := $(OBJDIR)/.build-flags
$(shell mkdir -p $(OBJDIR); f='$(CFLAGS)'; [ "$$(cat $(BUILD_FLAGS_STAMP) 2>/dev/null)" = "$$f" ] || printf '%s' "$$f" > $(BUILD_FLAGS_STAMP))

OBJS := $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS)) $(patsubst %.s,$(OBJDIR)/%.o,$(REC_ASM))
DEPS := $(OBJS:.o=.d)

.PHONY: all clean
.DELETE_ON_ERROR:
all: $(TARGET)

$(OBJDIR)/%.o: %.c $(BUILD_FLAGS_STAMP)
	@mkdir -p $(dir $@)
	@echo "  CC  $<"
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o: %.s $(BUILD_FLAGS_STAMP)
	@mkdir -p $(dir $@)
	@echo "  AS  $<"
	@$(CC) -x assembler-with-cpp $(WOS_ARCH_CFLAGS) -c $< -o $@

# startupwos.o FIRST: the WarpOS loader jumps to the first text hunk, and a
# reordered link dies before main(). The full link, debug info and all, is kept
# for addr2line; the converter gets it with only the debug sections dropped.
$(DEBUG_ELF): $(OBJS)
	@echo "  LD  $@"
	@$(LD) $(WOS_LINK_FLAGS) $(WOS_LIBRARY_DIRS) -o $@ \
		$(WOS_STARTFILE) $(OBJS) $(MGL_DIR)/lib/libminigl.a \
		$(WOS_RUNTIME_LIBS) $(WOS_ENDFILE)

$(ELF): $(DEBUG_ELF)
	@$(WOS_CROSS)objcopy --strip-debug $< $@
	$(call WOS_VALIDATE_ETREL,$@)

$(TARGET): $(ELF) tools/elf2warpos/elf2warpos.py
	@$(PYTHON) tools/elf2warpos/elf2warpos.py $< $@

clean:
	rm -rf $(OUT)

-include $(DEPS)
